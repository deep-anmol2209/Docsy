generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Test {
  id   String @id @default(cuid())
  name String
}

enum ArtifactType {
  SUMMARY
  STUDY_GUIDE
  FAQ
  TIMELINE
  QUIZ
  FLASHCARDS
  NOTES
  MIND_MAP
  TABLE
  CUSTOM
}
enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}
enum ArtifactStatus {
  GENERATING
  READY
  FAILED
  ARCHIVED
}
enum JobState {
  QUEUED
  VALIDATING
  PARSING
  OCR
  NORMALIZING
  ANALYZING
  SELECTING_STRATEGY
  CHUNKING
  ENRICHING
  EMBEDDING
  WRITING_TO_VECTOR_STORE
  COMPLETED
  FAILED
}

enum DocumentType {
  RESEARCH_PAPER
  PRESENTATION
  NOTES
  INVOICE
  TRANSCRIPT
  BOOK
  STRUCTURED
  UNSTRUCTURED
  UNKNOWN
}

enum BlockType {
  PARAGRAPH
  HEADING
  LIST_ITEM
  TABLE
  IMAGE_REFERENCE
  CODE_BLOCK
  QUOTE
  SLIDE
  TRANSCRIPT_SEGMENT
}


model User {
  id            String      @id
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  accounts      Account[]
  sessions      Session[]
  workspaces    Workspace[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Workspace {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?
  icon         String?
  defaultModel String   @default("gpt-4o-mini")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources      Source[]
  artifacts Artifact[]
  conversations Conversation[]
  @@index([userId])
  @@map("workspace")
}

enum SourceType {
  PDF
  WEBSITE
  YOUTUBE
  TEXT
  MARKDOWN
}

enum SourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Source {
  id          String       @id @default(cuid())
  workspaceId String
  type        SourceType
  title       String
  content     String?
  url         String?

  originalReference String?
  storageLocation   String?
  cloudinaryPublicId String?
  cloudinarySecureUrl String?
  mimeType          String?
  fileSizeBytes     Int?
  ingestionStatus   JobState  @default(QUEUED)
  uploadMetadata    Json?
  metadata    Json?
  createdAt   DateTime     @default(now())
  artifacts ArtifactSource[]
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks      Chunk[]
documents Document[]
  jobs      Job[]
  
  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([ingestionStatus])
  @@index([type])
  @@map("source")
}

model Chunk {
  id               String   @id @default(cuid())
  documentId       String
  sourceId         String
  order            Int
  content          String   @db.Text
  strategy         String
  page             Int?
  heading          String?
  section          String?
  startTimeSeconds Float?
  endTimeSeconds   Float?
  slideNumber      Int?
  tokenCount       Int?
  storageLocation  String?
  enrichmentFlags  Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  transcriptLines  Json?
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  source   Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([sourceId])
  @@index([strategy])
}



model Document {
  id              String       @id @default(cuid())
  sourceId        String
  title           String
  documentType    DocumentType @default(UNKNOWN)
  language        String?
  pageCount       Int?
  durationSeconds Float?
  chunkCount      Int          @default(0)
  parserName      String
  parserVersion   String
  analyzerVersion String
  isScanned       Boolean      @default(false)
  requiresOCR     Boolean      @default(false)
  metadataSummary Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  source Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks Chunk[]
  blocks DocumentBlock[]

  @@index([sourceId])
  @@index([documentType])
}


model DocumentBlock {
  id               String    @id @default(cuid())
  documentId       String
  type             BlockType
  content          String    @db.Text
  order            Int
  page             Int?
  headingLevel     Int?
  slideNumber      Int?
  startTimeSeconds Float?
  endTimeSeconds   Float?
  speaker          String?
  language         String?
  createdAt        DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([order])
}



model Job {
 id            String   @id @default(cuid())

  sourceId      String

  state         JobState @default(QUEUED)
  currentStage  JobState @default(QUEUED)

  retryCount    Int      @default(0)
  maxRetries    Int      @default(3)

  failureReason String?

  checkpoints   Json?

  metrics        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source       Source            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  stageHistory JobStageHistory[]

  @@index([sourceId])
  @@index([state])
}

model JobStageHistory {
  id        String    @id @default(cuid())
  jobId     String
  stage     JobState
  enteredAt DateTime  @default(now())
  exitedAt  DateTime?
  error     Json?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}


model Artifact {
  id            String           @id @default(cuid())

  workspaceId   String

  title         String
  description   String?

  type          ArtifactType
  status        ArtifactStatus   @default(GENERATING)

  content       String?          @db.Text

  metadata      Json?

  generationPrompt String?       @db.Text

  modelUsed     String?
  modelVersion  String?

  tokenUsage    Json?

  version       Int              @default(1)

  isPinned      Boolean          @default(false)
  isDeleted     Boolean          @default(false)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sources        ArtifactSource[]

  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([status])
  @@index([createdAt])

  @@map("artifact")
}

model ArtifactSource {

  artifactId String
  sourceId   String

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  source   Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([artifactId, sourceId])

  @@index([sourceId])

  @@map("artifact_source")
}


model Conversation {
  id                  String   @id @default(cuid())

  workspaceId         String

  title               String?

  // Running summary of older conversation history
  summary             String?  @db.Text

  // Number of messages already included
  // in the latest summary
  summaryMessageCount Int      @default(0)

  summarizedAt        DateTime?

  // Optional model selected for this conversation
  model               String?

  // Useful for future web-search/tool based chat
  metadata            Json?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation( fields: [workspaceId], references: [id], onDelete: Cascade)

  messages Message[]

  @@index([workspaceId])
  @@index([workspaceId, updatedAt])

  @@map("conversation")
}


model Message {
  id             String      @id @default(cuid())

  conversationId String

  role           MessageRole

  content        Json

  // Sources/chunks used to generate this answer
  citations      Json?

  // Optional metadata for generation/debugging
  metadata       Json?

  // Which model generated this assistant message
  model          String?

  // Token/cost information
  tokenUsage     Json?

  createdAt      DateTime    @default(now())

conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])

  @@map("message")
}